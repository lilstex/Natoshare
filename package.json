{
  "name": "natoshare",
  "private": true,
  "description": "Root workspace for Natoshare's two frontend apps and their shared types.",
  "workspaces": [
    "web/user-app",
    "web/admin-app",
    "web/shared-types"
  ],
  "scripts": {
    "dev:user": "npm run dev --workspace=user-app",
    "dev:admin": "npm run dev --workspace=admin-app",
    "lint:user": "npm run lint --workspace=user-app",
    "lint:admin": "npm run lint --workspace=admin-app",
    "build:user": "npm run build --workspace=user-app",
    "build:admin": "npm run build --workspace=admin-app"
  }
}
